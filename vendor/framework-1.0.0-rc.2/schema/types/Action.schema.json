{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "types/Action.schema.json",
 "title": "Action (schema v6 3.x)",
 "allOf": [
  {
   "$ref": "../common.schema.json"
  }
 ],
 "type": "object",
 "properties": {
  "description": {
   "type": "string",
   "description": "text; card. 1; "
  },
  "due_date": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}",
   "description": "date; card. 1; "
  },
  "raised_by": {
   "type": "string",
   "description": "ref(Person); card. 1; "
  },
  "source": {
   "description": "json; card. 0..1; {kind: Review, Condition of agreement or Checklist No; ref}"
  },
  "closure": {
   "description": "json; card. 1*; {evidence, closed_by: Person, closed_at, accepted_by: Person (raiser or review chair), accepted_at}"
  },
  "status": {
   "type": "string",
   "x-stored-as": "label of a framework-fixed register entry",
   "description": "reg; card. 1; Open; Closed; Cancelled",
   "enum": [
    "Open",
    "Closed",
    "Cancelled"
   ]
  },
  "type": {
   "const": "Action"
  }
 },
 "required": [
  "description",
  "due_date",
  "raised_by",
  "status"
 ],
 "x-owned-links": [
  "Raised at",
  "Tagged to"
 ]
}
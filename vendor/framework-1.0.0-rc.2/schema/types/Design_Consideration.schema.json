{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "types/Design_Consideration.schema.json",
 "title": "Design Consideration (schema v6 3.x)",
 "allOf": [
  {
   "$ref": "../common.schema.json"
  }
 ],
 "type": "object",
 "properties": {
  "discipline": {
   "anyOf": [
    {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^(VR-[A-Z]+-\\d{4}|ALL)$"
     }
    },
    {
     "type": "string",
     "pattern": "^(VR-[A-Z]+-\\d{4}|ALL)$"
    }
   ],
   "description": "reg(DISC); card. 1; Discipline register (Annex B.2 of v23)"
  },
  "description": {
   "type": "string",
   "description": "text; card. 1; Generic"
  },
  "guidance": {
   "type": "string",
   "description": "text; card. 1; Generic"
  },
  "checklists": {
   "description": "json; card. 0..n; {stage: reg(STAGE), items: [{item_id, question, applies_to: [Design Type, Design Sub-team or item property] 0..n}]}"
  },
  "property_filters": {
   "anyOf": [
    {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^(VR-[A-Z]+-\\d{4}|ALL)$"
     }
    },
    {
     "type": "string",
     "pattern": "^(VR-[A-Z]+-\\d{4}|ALL)$"
    }
   ],
   "description": "reg(PROP); card. 0..n; "
  },
  "type": {
   "const": "Design Consideration"
  }
 },
 "required": [
  "discipline",
  "description",
  "guidance"
 ],
 "x-owned-links": [
  "Applies to",
  "Governed by",
  "Informed by"
 ]
}
 "link_types": {
  "add": [
   "Part of (Requirement -> Requirement Document)",
   "Tagged to (Requirement Document -> Sub-system)",
   "Reviews line item (Line-item Review -> Requirement or TSM statement)"
  ]
 },
 "link_maturity": {
  "principle": "6B.7A: high-level links flow down; defined links at lowest level flow up and supersede; unlinked flowed-down items auto-superseded once the level has defined links; TSM needs DA bulk confirmation, EDR none",
  "settled": [
   "P1 defined link = Satisfied by to a Part/Assembly Instance (EDR) or claimed TSM statement naming parts",
   "P2 level has defined links = >=1 line item of the document has a defined link in the FDPS; per FDPS per document",
   "P3 manual Kept/Broken prevail",
   "P4 reversal when last defined link removed",
   "P5 new/changed items auto-superseded unless linked",
   "P6 one DA confirmation per FDPS per TSM; lapses on set change; DA may reject statements",
   "P7 no Compliance Statement for superseded items",
   "P8 defined links roll up to FDPS/Sub-system/System pages"
  ],
  "status": "P1 to P8 accepted by Daniel as written, 12 Oct 2026"
 }

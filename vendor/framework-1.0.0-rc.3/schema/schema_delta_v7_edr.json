 "new_types": {
  "Requirement Document": {
   "required": [
    "doc_kind",
    "doc_code",
    "issue",
    "sub_system_tags",
    "product_scope",
    "status"
   ],
   "properties": {
    "doc_kind": {
     "type": "string",
     "description": "reg(DOCKIND); EDR"
    },
    "doc_code": {
     "type": "string",
     "description": "Unique within the project, e.g. EDR-FUE"
    },
    "issue": {
     "type": "integer",
     "minimum": 1
    },
    "sub_system_tags": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string",
      "description": "reg(SUB)"
     },
     "description": "Many-to-many document-level Sub-system tag (6B.2)"
    },
    "issue_changes": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "issue": {
        "type": "integer"
       },
       "changed": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "added": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "removed": {
        "type": "array",
        "items": {
         "type": "string"
        }
       }
      }
     },
     "description": "Only changed line items are re-flagged (6B.10)"
    },
    "product_scope": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string"
     }
    },
    "status": {
     "enum": [
      "Draft",
      "Released",
      "Superseded",
      "Withdrawn"
     ]
    }
   }
  },
  "Line-item Review": {
   "required": [
    "fdps",
    "line_item",
    "line_item_revision",
    "state",
    "bases",
    "status"
   ],
   "properties": {
    "fdps": {
     "type": "string",
     "description": "ref(FDPS)"
    },
    "line_item": {
     "type": "object",
     "description": "{requirement} or {tsm, clause}",
     "properties": {
      "requirement": {
       "type": "string"
      },
      "tsm": {
       "type": "string"
      },
      "clause": {
       "type": "string"
      }
     }
    },
    "line_item_revision": {
     "type": "integer",
     "minimum": 1
    },
    "state": {
     "enum": [
      "Kept",
      "Broken",
      "Superseded (auto)"
     ],
     "description": "Superseded (auto) is set by the system only (6B.7A)"
    },
    "bases": {
     "type": "array",
     "minItems": 1
    },
    "reason": {
     "type": "string",
     "description": "Required when Broken"
    },
    "author": {
     "type": "string",
     "description": "ref(Person)"
    },
    "approved_by": {
     "type": "string",
     "description": "Required when Broken: EDR line item - Design Lead of the FDPS lead Sub-system (or Sub-structure); TSM statement - Design Authority (6C.13)"
    },
    "approved_at": {
     "type": "string",
     "description": "datetime"
    },
    "status": {
     "enum": [
      "Current",
      "Flagged for re-confirmation"
     ]
    },
    "superseded_by": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "Defined links causing the supersession"
    },
    "bulk_confirmation": {
     "type": "string",
     "description": "ref(TSM Supersession Confirmation); TSM statements only; empty = pending"
    }
   },
   "if_broken_required": [
    "reason",
    "author",
    "approved_by",
    "approved_at"
   ]
  },
  "TSM Supersession Confirmation": {
   "required": [
    "fdps",
    "tsm",
    "statements",
    "confirmed_by",
    "confirmed_at",
    "status"
   ],
   "properties": {
    "fdps": {
     "type": "string"
    },
    "tsm": {
     "type": "string"
    },
    "statements": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "properties": {
       "clause": {
        "type": "string"
       },
       "revision": {
        "type": "integer"
       }
      }
     }
    },
    "rejected": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "clause": {
        "type": "string"
       },
       "reason": {
        "type": "string"
       }
      }
     }
    },
    "confirmed_by": {
     "type": "string",
     "description": "Design Authority (6C.13)"
    },
    "confirmed_at": {
     "type": "string"
    },
    "status": {
     "enum": [
      "Current",
      "Lapsed"
     ]
    }
   }
  }
 },

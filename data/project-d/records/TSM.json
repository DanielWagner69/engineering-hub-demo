  "issue": 5,
  "statements": [
   {
    "clause": "2.1",
    "statement": "Standard Parts shall be procured to the catalogue issue recorded on the Part revision."
   },
   {
    "clause": "3.4",
    "statement": "Self-locking nuts shall show not less than 1.5 thread pitches of bolt protrusion when installed."
   },
   {
    "clause": "6.2",
    "statement": "Blind rivets shall not be used in fuel-wetted zones."
   }
  ],

  "manual_code": "TSM-PIPE",
  "issue": 4,
  "statements": [
   {
    "clause": "3.1.4",
    "statement": "Rigid pipe bends shall have a centreline radius of not less than 3 times the outside diameter."
   },
   {
    "clause": "3.6.1",
    "statement": "Flexible hose assemblies shall be supported so that the minimum bend radius is not infringed at full articulation."
   }
  ],

  },
  "verification_status": "Verified",
  "verified_by": "user:o.fry",
  "verified_at": "2025-10-01T09:00:00Z",
  "access_marking": "VR-ACCESS-0001",
  "manual_code": "TSM-FLU",
  "issue": 3,
  "statements": [
   {
    "clause": "5.1",
    "statement": "Every component installed in a fuel-wetted or fuel-vapour zone shall be electrically bonded to structure with a resistance of not more than 10 milliohm."
   },
   {
    "clause": "5.4",
    "statement": "Fuel feed line installations shall be routed with no high point between a shut-off valve and the engine interface at which vapour can collect."
   },
   {
    "clause": "6.2",
    "statement": "Hydraulic components shall be compatible with the hydraulic fluid specification of the project."
   },
   {
    "clause": "7.4",
    "statement": "Pneumatic ducts above 200 degrees Celsius shall be lagged where they pass within 50 mm of a fluid line."
   }
  ],
  "acceptance": {
   "state": "Accepted",
   "accepted_by": "user:o.fry",
